# AutoRef Local Server Configuration Example
# Copy this file to .env and set your API_KEY
API_KEY=

# Agent Model (e.g., nvidia/llama-3.1-nemotron-70b-instruct, meta/llama-3.3-70b-instruct)
MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Local companion server port and host
PORT=8787
HOST=127.0.0.1
